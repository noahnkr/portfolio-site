---
import 'katex/dist/katex.min.css';
import '../styles/prose.css';
import Base from './Base.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  /** Makes the eyebrow a link, e.g. to the post's topic. */
  eyebrowHref?: string;
  meta?: string[];
  links?: { label: string; href: string }[];
  prev?: { href: string; title: string } | null;
  next?: { href: string; title: string } | null;
  back: { href: string; label: string };
}

const { title, description, eyebrow, eyebrowHref, meta = [], links = [], prev, next, back } = Astro.props;
---

<Base title={title} description={description} type="article">
  <header class="topbar">
    <a class="home" href="/">{site.name}</a>
    <nav aria-label="Site">
      <a href="/#projects">Projects</a>
      <a href="/blog/">Writing</a>
      <ThemeToggle />
    </nav>
  </header>

  <main id="content" class="article">
    <header class="head">
      {
        eyebrow &&
          (eyebrowHref ? (
            <a class="eyebrow eyebrow-link" href={eyebrowHref}>
              {eyebrow}
            </a>
          ) : (
            <span class="eyebrow">{eyebrow}</span>
          ))
      }
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      {meta.length > 0 && <p class="meta">{meta.join(' · ')}</p>}
      {
        links.length > 0 && (
          <p class="links">
            {links.map((l) => (
              <a href={l.href} target="_blank" rel="noopener">
                {l.label} ↗
              </a>
            ))}
          </p>
        )
      }
    </header>

    <slot name="figure" />

    <div class="prose">
      <slot />
    </div>

    <footer class="pager">
      {
        prev ? (
          <a class="pg prev" href={prev.href}>
            <span class="eyebrow">Previous</span>
            <span class="pg-title">{prev.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a class="pg next" href={next.href}>
            <span class="eyebrow">Next</span>
            <span class="pg-title">{next.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      <a class="back" href={back.href}>← {back.label}</a>
    </footer>
  </main>
</Base>

<style>
  .topbar {
    max-width: 1180px;
    margin: 0 auto;
    padding-left: var(--gutter);
    padding-right: var(--gutter-r);
    padding-block: calc(28px + env(safe-area-inset-top, 0px)) 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .home {
    font: 400 22px/1 var(--f-serif);
    font-variation-settings: 'opsz' 30;
    text-decoration: none;
  }
  .topbar nav {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 14px;
  }
  .topbar nav a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .topbar nav a:hover {
    color: var(--fg);
  }

  .article {
    max-width: calc(700px + var(--gutter) + var(--gutter-r));
    margin: 0 auto;
    padding-left: var(--gutter);
    padding-right: var(--gutter-r);
    padding-block: 88px 120px;
  }
  .head {
    display: grid;
    gap: 14px;
    margin-bottom: 48px;
  }
  .head h1 {
    margin: 0;
    font: 400 clamp(36px, 6vw, 52px)/1.08 var(--f-serif);
    font-variation-settings: 'opsz' 72;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .eyebrow-link {
    width: max-content;
    text-decoration: none;
    transition: color 0.2s;
  }
  .eyebrow-link:hover {
    color: var(--fg);
  }
  .lede {
    margin: 0;
    font: 400 21px/1.45 var(--f-serif);
    font-variation-settings: 'opsz' 24;
    color: var(--muted);
    text-wrap: pretty;
  }
  .meta {
    margin: 4px 0 0;
    font-size: 13px;
    color: var(--muted);
  }
  .links {
    margin: 0;
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    font-size: 14px;
    font-weight: 500;
  }
  .links a {
    text-decoration: none;
  }
  .links a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .pager {
    margin-top: 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    border-top: 1px solid var(--line);
    padding-top: 28px;
  }
  .pg {
    display: grid;
    gap: 4px;
    text-decoration: none;
  }
  .pg.next {
    text-align: right;
  }
  .pg-title {
    font: 400 19px/1.3 var(--f-serif);
    transition: color 0.2s;
  }
  .pg:hover .pg-title {
    color: var(--muted);
  }
  .back {
    grid-column: 1 / -1;
    margin-top: 24px;
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
  }
  .back:hover {
    color: var(--fg);
  }

  @media (max-width: 600px) {
    .article {
      padding-block: 56px 96px;
    }
    .pager {
      grid-template-columns: 1fr;
    }
    .pg.next {
      text-align: left;
    }
  }
</style>
