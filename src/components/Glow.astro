---
/**
 * Two soft background glows.
 * - Each scroll position maps to a destination: a hue (teal at the top → +300° at the bottom)
 *   and two glow spots, read off a smooth curve through "anchors" — elements marked [data-glow]
 *   (home page sections), else the <h2>s in an article, else the page top and bottom.
 * - The glows spring straight from where they are to that destination (2D for position,
 *   shortest way round the color wheel for hue). Slow scrolling still traces the curve because
 *   the destination moves gradually; a jump moves the destination at once, so the glow glides
 *   directly there instead of replaying every section in between.
 * - Critically damped springs with speed caps: starts gently, never overshoots, and a new
 *   jump mid-glide bends the path smoothly using the current velocity.
 */
---

<div class="glow" aria-hidden="true">
  <span class="blob b1"></span>
  <span class="blob b2"></span>
</div>

<style>
  .glow {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .blob {
    position: absolute;
    width: min(760px, 110vw);
    aspect-ratio: 1;
    border-radius: 50%;
    translate: -50% -50%;
    will-change: left, top;
    animation: drift 24s ease-in-out infinite alternate;
  }
  .b1 {
    left: 16%;
    top: 16%;
    background: radial-gradient(
      circle,
      oklch(var(--glow-l) var(--glow-c) var(--h) / var(--glow-a)),
      transparent 64%
    );
  }
  .b2 {
    left: 84%;
    top: 74%;
    animation-duration: 31s;
    animation-direction: alternate-reverse;
    background: radial-gradient(
      circle,
      oklch(var(--glow-l) var(--glow-c) calc(var(--h) + 70) / var(--glow-a2)),
      transparent 64%
    );
  }
  @keyframes drift {
    from {
      transform: translate(0, 0) scale(1);
    }
    to {
      transform: translate(4%, 7%) scale(1.08);
    }
  }
</style>

<script>
  const HUE_START = 170;
  const HUE_RANGE = 300;
  const SMOOTH_TIME = 0.6; // seconds; higher = floatier
  const MAX_MOVE_SPEED = 32; // % of the viewport per second; caps how fast a glow can travel
  const MAX_HUE_SPEED = 90; // degrees per second; caps how fast the color can change

  // Resting spots for the two glows, as [left%, top%] pairs; cycled across anchors.
  const SPOTS: [number, number][][] = [
    [[16, 16], [84, 74]],
    [[30, 32], [88, 40]],
    [[52, 38], [22, 78]],
    [[42, 62], [80, 36]],
    [[26, 76], [74, 24]],
  ];

  const root = document.documentElement;
  const blobs = [...document.querySelectorAll<HTMLElement>('.glow .blob')];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  type Anchor = { p: number; pos: [number, number][] };
  type Vec = { x: number; y: number };
  let anchors: Anchor[] = [];
  let raf = 0;
  let last = 0;

  // Live state: where each glow is, how fast it's moving, and the current hue.
  let spots: Vec[] = [];
  let spotVel: Vec[] = [];
  let hue = HUE_START;
  let hueVel = 0;

  const clamp01 = (n: number) => Math.min(1, Math.max(0, n));
  const maxScroll = () => Math.max(1, root.scrollHeight - innerHeight);
  const progress = () => clamp01(scrollY / maxScroll());

  function anchorElements(): Element[] {
    const marked = [...document.querySelectorAll('[data-glow]')];
    if (marked.length >= 2) return marked;
    const heads = [...document.querySelectorAll('main h2')];
    return heads.length >= 2 ? heads : [];
  }

  function measure() {
    const els = anchorElements();
    const max = maxScroll();
    if (els.length < 2) {
      anchors = [
        { p: 0, pos: SPOTS[0] },
        { p: 1, pos: SPOTS[2] },
      ];
      return;
    }
    anchors = els.map((el, i) => ({
      p: clamp01((el.getBoundingClientRect().top + scrollY - innerHeight * 0.25) / max),
      pos: SPOTS[i % SPOTS.length],
    }));
    anchors[0].p = 0;
    anchors[anchors.length - 1].p = 1;
  }

  // Catmull-Rom spline through the anchors: continuous speed, no sudden turns.
  const cr = (p0: number, p1: number, p2: number, p3: number, t: number) =>
    0.5 *
    (2 * p1 +
      (-p0 + p2) * t +
      (2 * p0 - 5 * p1 + 4 * p2 - p3) * t * t +
      (-p0 + 3 * p1 - 3 * p2 + p3) * t * t * t);

  function positionAt(p: number) {
    const n = anchors.length;
    let i = 0;
    while (i < n - 2 && p > anchors[i + 1].p) i++;
    const a = anchors[i];
    const b = anchors[i + 1];
    const t = clamp01((p - a.p) / (b.p - a.p || 1));
    const P = (j: number) => anchors[Math.min(n - 1, Math.max(0, j))].pos;
    return [0, 1].map((k) =>
      [0, 1].map((axis) => cr(P(i - 1)[k][axis], P(i)[k][axis], P(i + 1)[k][axis], P(i + 2)[k][axis], t)),
    );
  }

  // Critically damped spring toward a target with a speed cap (after Unity's SmoothDamp),
  // in 2D so a capped move still travels in a straight line.
  function smoothDamp(c: Vec, t: Vec, v: Vec, maxSpeed: number, dt: number): [Vec, Vec] {
    const omega = 2 / SMOOTH_TIME;
    const x = omega * dt;
    const e = 1 / (1 + x + 0.48 * x * x + 0.235 * x * x * x);
    let cx = c.x - t.x;
    let cy = c.y - t.y;
    const maxChange = maxSpeed * SMOOTH_TIME;
    const len = Math.hypot(cx, cy);
    if (len > maxChange) {
      cx *= maxChange / len;
      cy *= maxChange / len;
    }
    const tx = c.x - cx;
    const ty = c.y - cy;
    const tempX = (v.x + omega * cx) * dt;
    const tempY = (v.y + omega * cy) * dt;
    let out = { x: tx + (cx + tempX) * e, y: ty + (cy + tempY) * e };
    let nv = { x: (v.x - omega * tempX) * e, y: (v.y - omega * tempY) * e };
    // Never overshoot the target.
    if ((t.x - c.x) * (out.x - t.x) + (t.y - c.y) * (out.y - t.y) > 0) {
      out = { ...t };
      nv = { x: 0, y: 0 };
    }
    return [out, nv];
  }

  // While an in-page link's smooth scroll is running, aim straight at where it will land
  // instead of at each section it scrolls past.
  let lockedP: number | null = null;
  let lockTimer = 0;
  function unlock() {
    lockedP = null;
    clearTimeout(lockTimer);
    if (!raf) raf = requestAnimationFrame(paint);
  }
  function lockTo(el: Element) {
    const margin = parseFloat(getComputedStyle(el).scrollMarginTop) || 0;
    const landing = el.getBoundingClientRect().top + scrollY - margin;
    lockedP = clamp01(landing / maxScroll());
    clearTimeout(lockTimer);
    lockTimer = window.setTimeout(unlock, 2000); // fallback where `scrollend` isn't supported
    if (!raf) raf = requestAnimationFrame(paint);
  }
  document.addEventListener('click', (e) => {
    const a = (e.target as Element | null)?.closest?.('a[href*="#"]') as HTMLAnchorElement | null;
    if (!a || a.pathname !== location.pathname || !a.hash) return;
    const el = document.getElementById(decodeURIComponent(a.hash.slice(1)));
    if (el) lockTo(el);
  });
  addEventListener('scrollend', unlock);
  // Any manual scrolling takes back control immediately.
  for (const type of ['wheel', 'touchstart', 'keydown'] as const) {
    addEventListener(type, () => lockedP !== null && unlock(), { passive: true });
  }

  // Destination for the current scroll position (or the pending jump's landing spot).
  function destination() {
    const p = lockedP ?? progress();
    const rawHue = HUE_START + p * HUE_RANGE;
    // Pick the equivalent hue nearest the current one, so color takes the short way round.
    const hueTarget = rawHue + 360 * Math.round((hue - rawHue) / 360);
    const pos = positionAt(p).map(([x, y]) => ({ x, y }));
    return { hueTarget, pos };
  }

  function apply() {
    root.style.setProperty('--h', hue.toFixed(1));
    spots.forEach((s, i) => {
      blobs[i].style.left = `${s.x}%`;
      blobs[i].style.top = `${s.y}%`;
    });
  }

  function paint(now: number) {
    const dt = last ? Math.min(0.1, (now - last) / 1000) : 1 / 60;
    last = now;
    const { hueTarget, pos } = destination();

    if (reduced) {
      hue = hueTarget;
      hueVel = 0;
      spots = pos;
      spotVel = pos.map(() => ({ x: 0, y: 0 }));
    } else {
      const [h, hv] = smoothDamp({ x: hue, y: 0 }, { x: hueTarget, y: 0 }, { x: hueVel, y: 0 }, MAX_HUE_SPEED, dt);
      hue = h.x;
      hueVel = hv.x;
      spots.forEach((s, i) => {
        [spots[i], spotVel[i]] = smoothDamp(s, pos[i], spotVel[i], MAX_MOVE_SPEED, dt);
      });
    }

    const settled =
      Math.abs(hue - hueTarget) < 0.05 &&
      Math.abs(hueVel) < 0.05 &&
      spots.every(
        (s, i) => Math.hypot(s.x - pos[i].x, s.y - pos[i].y) < 0.02 && Math.hypot(spotVel[i].x, spotVel[i].y) < 0.02,
      );
    if (settled) {
      hue = hueTarget;
      hueVel = 0;
      spots = pos;
      spotVel = pos.map(() => ({ x: 0, y: 0 }));
    }
    apply();

    if (settled) {
      raf = 0;
      last = 0;
    } else {
      raf = requestAnimationFrame(paint);
    }
  }

  function onScroll() {
    if (!raf) raf = requestAnimationFrame(paint);
  }

  // Start at rest on the destination for wherever the page loaded.
  measure();
  {
    const p = progress();
    hue = HUE_START + p * HUE_RANGE;
    spots = positionAt(p).map(([x, y]) => ({ x, y }));
    spotVel = spots.map(() => ({ x: 0, y: 0 }));
    apply();
  }

  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', () => {
    measure();
    onScroll();
  });
  // Fonts and images change the page height; re-measure once they settle.
  document.fonts?.ready.then(() => {
    measure();
    onScroll();
  });
  addEventListener('load', () => {
    measure();
    onScroll();
  });
</script>
