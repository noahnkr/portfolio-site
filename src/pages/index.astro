---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Icon from '../components/Icon.astro';
import { site, about, experience, contacts } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.part ?? 0) - (b.data.part ?? 0) || a.data.date.valueOf() - b.data.date.valueOf(),
);

const sections = [
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'projects', label: 'Projects' },
  { id: 'writing', label: 'Writing' },
  { id: 'contact', label: 'Contact' },
];

// Small text helpers for the About section: escape, then allow *emphasis* (as in PEP 20)
// and link the first mention of "The Zen of Python".
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const inlineEm = (s: string) => escape(s).replace(/\*(.+?)\*/g, '<em>$1</em>');
const introHtml = inlineEm(about.intro).replace(
  'The Zen of Python',
  `<a href="${about.zenUrl}" target="_blank" rel="noopener">The Zen of Python</a>`,
);
---

<Base>
  <div class="page">
    <header class="side">
      <span class="eyebrow">{site.role}</span>
      <h1>{site.name}</h1>
      <figure class="tagline">
        <blockquote>“{site.tagline.quote}”</blockquote>
        <figcaption>{site.tagline.author}</figcaption>
      </figure>

      <nav class="nav" aria-label="Sections">
        {sections.map((s) => <a href={`#${s.id}`} data-sec={s.id}>{s.label}</a>)}
      </nav>

      <div class="foot">
        {site.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}
        {site.resume && <a href={site.resume} target="_blank" rel="noopener">Résumé ↗</a>}
        <ThemeToggle />
      </div>
    </header>

    <main id="content">
      <section id="about" data-glow aria-labelledby="about-h">
        <h2 id="about-h">About</h2>
        <p class="lede" set:html={introHtml} />
        <ol class="zen">
          {
            about.zen.map((z) => (
              <li>
                <p class="zen-line" set:html={inlineEm(z.line)} />
                <p class="zen-meaning">{z.meaning}</p>
              </li>
            ))
          }
        </ol>
        <p class="muted">{about.outro}</p>
      </section>

      <section id="experience" data-glow aria-labelledby="experience-h">
        <h2 id="experience-h">Experience</h2>
        <ol class="jobs">
          {
            experience.map((job) => (
              <li class="job">
                <span class="job-dates">{job.dates}</span>
                <div>
                  <h3>
                    {job.title} <span class="muted">· {job.org}</span>
                  </h3>
                  <p class="muted">{job.summary}</p>
                  {job.tags && (
                    <ul class="row-tags">
                      {job.tags.map((t) => <li>{t}</li>)}
                    </ul>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="projects" data-glow aria-labelledby="projects-h">
        <h2 id="projects-h">Selected projects <small>{projects.length}</small></h2>
        <div class="list">
          {
            projects.map((p) => (
              <a class="row" href={`/projects/${p.id}/`}>
                <span class="row-title">
                  {p.data.title}
                  <span class="arrow" aria-hidden="true">↗</span>
                </span>
                <span class="row-meta">{p.data.kind}</span>
                <span class="row-desc">{p.data.summary}</span>
                <ul class="row-tags">
                  {p.data.stack.map((t) => <li>{t}</li>)}
                </ul>
              </a>
            ))
          }
        </div>
      </section>

      <section id="writing" data-glow aria-labelledby="writing-h">
        <h2 id="writing-h">Writing <small>{posts[0]?.data.series ?? 'Notes'}</small></h2>
        <div class="list">
          {
            posts.map((p) => (
              <a class="row post" href={`/blog/${p.id}/`}>
                <span class="row-title">{p.data.title}</span>
                <span class="row-meta">{p.data.readTime.replace(' read', '')}</span>
              </a>
            ))
          }
        </div>
      </section>

      <section id="contact" data-glow aria-labelledby="contact-h" class="contact">
        <h2 id="contact-h">Contact</h2>
        <p class="muted">Questions about a post or a project? Feel free to reach out.</p>
        <div class="reach">
          <ul class="links" aria-label="Contact links">
            {
              contacts.map((c) => {
                const tip = c.copy ? `${c.label}: ${c.copy}` : c.label;
                const external = c.href && !c.href.startsWith('mailto:');
                return (
                  <li>
                    {c.href ? (
                      <a
                        href={c.href}
                        target={external ? '_blank' : undefined}
                        rel={external ? 'noopener' : undefined}
                        aria-label={tip}
                        title={tip}
                        data-copy={c.copy}
                        data-label={c.label}
                      >
                        <Icon name={c.icon} />
                      </a>
                    ) : (
                      <button type="button" aria-label={`Copy ${tip}`} title={tip} data-copy={c.copy} data-label={c.label}>
                        <Icon name={c.icon} />
                      </button>
                    )}
                  </li>
                );
              })
            }
          </ul>
          <span class="copied" role="status" aria-live="polite"></span>
        </div>
      </section>
    </main>
  </div>
</Base>

<style>
  .page {
    max-width: 1180px;
    margin: 0 auto;
    padding-left: var(--gutter);
    padding-right: var(--gutter-r);
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr);
    gap: 72px;
  }

  /* Sticky identity column */
  .side {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    padding-block: calc(88px + env(safe-area-inset-top, 0px)) 44px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  h1 {
    margin: 0;
    font: 400 60px/1 var(--f-serif);
    font-variation-settings: 'opsz' 72;
    letter-spacing: -0.02em;
  }
  .tagline {
    margin: 8px 0 0;
    max-width: 30ch;
    display: grid;
    gap: 6px;
  }
  .tagline blockquote {
    margin: 0;
    font: italic 400 20px/1.35 var(--f-serif);
    font-variation-settings: 'opsz' 24;
    text-indent: -0.4em; /* hang the opening quote mark */
  }
  .tagline figcaption {
    font-size: 13px;
    color: var(--muted);
  }
  .tagline figcaption::before {
    content: '— ';
  }

  /* About: lines from PEP 20, each with what it means to me */
  .zen {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: grid;
    gap: 22px;
    max-width: 52ch;
  }
  .zen li {
    display: grid;
    gap: 4px;
  }
  .zen-line {
    font: 400 21px/1.35 var(--f-serif);
    font-variation-settings: 'opsz' 24;
  }
  .zen-meaning {
    font-size: 15px;
    color: var(--muted);
  }
  .lede :global(a) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    text-decoration-color: oklch(var(--glow-l) var(--glow-c) var(--h));
  }

  .nav {
    display: grid;
    gap: 2px;
    margin-top: 40px;
  }
  .nav a {
    display: flex;
    align-items: center;
    gap: 16px;
    width: max-content;
    color: var(--muted);
    text-decoration: none;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 8px 0;
    transition: color 0.25s;
  }
  .nav a::before {
    content: '';
    height: 1px;
    width: 32px;
    background: currentColor;
    transition: width 0.35s var(--ease);
  }
  .nav a:hover,
  .nav a.on {
    color: var(--fg);
  }
  .nav a:hover::before,
  .nav a.on::before {
    width: 72px;
  }

  .foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    font-size: 14px;
    color: var(--muted);
  }
  .foot a {
    text-decoration: none;
    transition: color 0.2s;
  }
  .foot a:hover {
    color: var(--fg);
  }
  .foot :global(.theme-toggle) {
    margin-left: auto;
  }

  /* Content column */
  main {
    padding-block: calc(88px + env(safe-area-inset-top, 0px)) 30vh;
    display: grid;
    gap: 96px;
    min-width: 0;
  }
  section {
    display: grid;
    gap: 20px;
    scroll-margin-top: 72px;
    min-width: 0;
  }
  h2 {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 12px;
    font: 400 32px/1.1 var(--f-serif);
    font-variation-settings: 'opsz' 48;
    letter-spacing: -0.01em;
  }
  h2 small {
    font: 500 12px var(--f-sans);
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  section p {
    margin: 0;
    max-width: 62ch;
  }
  .lede {
    font: 400 27px/1.32 var(--f-serif);
    font-variation-settings: 'opsz' 36;
    max-width: 30ch;
    text-wrap: balance;
  }

  .jobs {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .job {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 20px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }
  .job:last-child {
    border-bottom: 1px solid var(--line);
  }
  .job-dates {
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 4px;
  }
  .job h3 {
    margin: 0 0 4px;
    font-size: 16px;
    font-weight: 500;
  }
  .job p {
    font-size: 15px;
  }

  .reach {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-left: -8px; /* optical alignment: the icons' padding lines up with the text edge */
  }
  .contact .links {
    display: flex;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .contact .links a,
  .contact .links button {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s, background-color 0.2s;
  }
  .contact .links a:hover,
  .contact .links button:hover {
    color: var(--fg);
    background: var(--surface);
  }
  .copied {
    font-size: 13px;
    color: var(--muted);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .copied.show {
    opacity: 1;
  }

  @media (max-width: 860px) {
    .page {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .side {
      position: static;
      height: auto;
      padding-block: calc(56px + env(safe-area-inset-top, 0px)) 0;
    }
    h1 {
      font-size: 46px;
    }
    .nav {
      display: none;
    }
    .foot {
      margin-top: 18px;
    }
    main {
      padding-block: 56px 120px;
      gap: 72px;
    }
    .job {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>

<script>
  // Nav marks follow the section in view.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.nav a')];
  const setOn = (id: string) => links.forEach((a) => a.classList.toggle('on', a.dataset.sec === id));
  const sections = [...document.querySelectorAll<HTMLElement>('main section')];
  const lastId = sections[sections.length - 1]?.id;
  const atBottom = () => scrollY + innerHeight >= document.documentElement.scrollHeight - 4;

  // While a nav click's smooth scroll runs, keep the clicked link marked instead of
  // flickering through every section the page scrolls past.
  let clicked = false;
  let releaseTimer = 0;
  const release = () => {
    if (!clicked) return;
    clicked = false;
    clearTimeout(releaseTimer);
    schedule(); // re-sync with where the page actually landed
  };

  // The current section is the last one whose top has passed a line 35% down the viewport.
  // Computed from positions on every scroll, so it's the same whichever way you scroll.
  // At the very bottom the last section wins: it's often too short to reach that line.
  const update = () => {
    if (clicked) return;
    if (atBottom() && lastId) return setOn(lastId);
    const line = innerHeight * 0.35;
    let current = sections[0]?.id;
    for (const s of sections) {
      if (s.getBoundingClientRect().top <= line) current = s.id;
    }
    if (current) setOn(current);
  };
  let frame = 0;
  const schedule = () => {
    if (!frame) frame = requestAnimationFrame(() => ((frame = 0), update()));
  };
  addEventListener('scroll', schedule, { passive: true });
  addEventListener('resize', schedule);

  links.forEach((a) =>
    a.addEventListener('click', () => {
      setOn(a.dataset.sec!);
      clicked = true;
      clearTimeout(releaseTimer);
      releaseTimer = window.setTimeout(release, 2000); // fallback where `scrollend` isn't supported
    }),
  );
  addEventListener('scrollend', release);
  for (const type of ['wheel', 'touchstart', 'keydown'] as const) {
    addEventListener(type, release, { passive: true });
  }

  update();

  // Contact icons with data-copy put their text on the clipboard (email still opens the mail
  // app if there is one). If the clipboard is unavailable, show the text so it can be copied.
  const status = document.querySelector<HTMLElement>('.copied');
  let hideTimer = 0;
  const say = (msg: string) => {
    if (!status) return;
    status.textContent = msg;
    status.classList.add('show');
    clearTimeout(hideTimer);
    hideTimer = window.setTimeout(() => status.classList.remove('show'), 2500);
  };
  document.querySelectorAll<HTMLElement>('.links [data-copy]').forEach((el) =>
    el.addEventListener('click', async () => {
      const text = el.dataset.copy!;
      try {
        await navigator.clipboard.writeText(text);
        say(`Copied ${text}`);
      } catch {
        say(`${el.dataset.label}: ${text}`);
      }
    }),
  );
</script>
