---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import { site } from '../../data/site';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.part ?? 0) - (b.data.part ?? 0) || a.data.date.valueOf() - b.data.date.valueOf(),
);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<Base title="Writing" description="Notes and long-form posts on machine learning, written from scratch.">
  <header class="topbar">
    <a class="home" href="/">{site.name}</a>
    <ThemeToggle />
  </header>
  <main id="content" class="wrap">
    <span class="eyebrow">Writing</span>
    <h1>Machine learning, from scratch</h1>
    <p class="intro muted">
      A series that builds up the fundamentals one model at a time, starting with the math and ending with support
      vector machines.
    </p>
    <div class="list">
      {
        posts.map((p) => (
          <a class="row post" href={`/blog/${p.id}/`}>
            <span class="row-title">{p.data.title}</span>
            <span class="row-meta">{fmt(p.data.date)}</span>
            <span class="row-desc">{p.data.description}</span>
          </a>
        ))
      }
    </div>
  </main>
</Base>

<style>
  .topbar {
    max-width: 1180px;
    margin: 0 auto;
    padding-left: var(--gutter);
    padding-right: var(--gutter-r);
    padding-block: calc(28px + env(safe-area-inset-top, 0px)) 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .home {
    font: 400 22px/1 var(--f-serif);
    text-decoration: none;
  }
  .wrap {
    max-width: calc(760px + var(--gutter) + var(--gutter-r));
    margin: 0 auto;
    padding-left: var(--gutter);
    padding-right: var(--gutter-r);
    padding-block: 88px 120px;
    display: grid;
    gap: 14px;
  }
  h1 {
    margin: 0;
    font: 400 clamp(36px, 6vw, 52px)/1.08 var(--f-serif);
    font-variation-settings: 'opsz' 72;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .intro {
    margin: 0 0 32px;
    max-width: 60ch;
    font-size: 17px;
  }
</style>
