---
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { getPosts, topicHref, formatDate, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    // Previous/next walk the post's own topic in reading order (oldest to newest).
    const thread = posts.filter((p) => p.data.topic === post.data.topic).reverse();
    const i = thread.indexOf(post);
    return {
      params: { slug: post.id },
      props: { post, prev: thread[i - 1] ?? null, next: thread[i + 1] ?? null },
    };
  });
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const link = (p: Post | null) => (p ? { href: `/blog/${p.id}/`, title: p.data.title } : null);
---

<Article
  title={post.data.title}
  description={post.data.description}
  eyebrow={post.data.topic}
  eyebrowHref={topicHref(post.data.topic)}
  meta={[formatDate(post.data.date, 'long'), post.data.readTime]}
  prev={link(prev)}
  next={link(next)}
  back={{ href: '/blog/', label: 'All writing' }}
>
  <Content />
</Article>
